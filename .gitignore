/xlsx-*.txt

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Firebase service account keys (never commit)
*firebase-adminsdk*.json
*-firebase-adminsdk-*.json

# vercel
.vercel

# local nested copy (canonical app lives at repo root)
/web

# typescript
*.tsbuildinfo
